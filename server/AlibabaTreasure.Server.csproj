<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <Version>1.0.0</Version>
    <Authors>R_F</Authors>
    <RootNamespace>AlibabaTreasure.Server</RootNamespace>
    <AssemblyName>AlibabaTreasure</AssemblyName>

    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ids and setting ranges are shared with the BepInEx plugin so both halves agree on them. -->
    <Compile Include="..\Shared\TreasureIds.cs" Link="TreasureIds.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- SPT 4.1 ships as SPTushonka.*; the assemblies inside are still SPTarkov.*. -->
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Reflection" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
  </ItemGroup>


  <!--
    Drop the built mod into the server's user\mods folder.
    Windows-only, because SptRoot is a Windows path: a Linux/CI build would otherwise create a
    directory literally named "E:\SPT 4.1" in the repo. Pass -p:OS=Windows_NT to force it.
    Skip with -p:SkipDeploy=true when the server is running and holding the dll open.
  -->
  <Target Name="DeployToSpt" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' AND '$(SkipDeploy)' != 'true' AND '$(SptModsDir)' != '' AND '$(SptRoot)' != 'CHANGE_ME'">
    <PropertyGroup>
      <ModDeployDir>$(SptModsDir)\AlibabaTreasure\</ModDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(ModDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)"
          SkipUnchangedFiles="false" ContinueOnError="WarnAndContinue" />
    <!-- config\config.json is written by the mod itself on first start (and by F12 changes),
         so it is never shipped or overwritten here. -->
    <Message Text="Deployed $(TargetFileName) to $(ModDeployDir)" Importance="high" />
  </Target>


  <!--
    Rule 2-2: every Release build also drops a ready-to-ship archive in release/.
    Skip with -p:SkipPackage=true.
  -->
  <Target Name="PackageRelease" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipPackage)' != 'true'">
    <PropertyGroup>
      <PackageStageDir>$(IntermediateOutputPath)package\</PackageStageDir>
      <PackageZipDir>$(MSBuildThisFileDirectory)release\</PackageZipDir>
      <PackageZipPath>$(PackageZipDir)AlibabaTreasure-Server-$(Version).zip</PackageZipPath>
    </PropertyGroup>
    <ItemGroup>
      <PackageFiles Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.deps.json" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="@(PackageFiles)"
          DestinationFiles="@(PackageFiles->'$(PackageStageDir)SPT_Runtime\user\mods\AlibabaTreasure\%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$(PackageZipDir)" />
    <Delete Files="$(PackageZipPath)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZipPath)" Overwrite="true" />
    <Message Text="Packaged $(PackageZipPath)" Importance="high" />
  </Target>

</Project>
